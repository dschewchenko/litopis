{
  "name": "litopis",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible date and calendar primitives.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter @litopis/core build && bun run --filter @litopis/dom build && bun run --filter @litopis/elements build && bun run --filter @litopis/react build && bun run --filter @litopis/vue build && bun run --filter @litopis/solid build && bun run --filter @litopis/svelte build && bun run --filter @litopis/docs build",
    "changeset": "changeset",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "dev": "bun run --filter @litopis/docs dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --tsconfig tsconfig.typecheck.json .",
    "prepare": "lefthook install",
    "release": "bun run build && changeset publish",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "version": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@types/react": "^19.2.7",
    "happy-dom": "^20.0.10",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "react": "^19.2.3",
    "solid-js": "^1.9.10",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "vue": "^3.5.26"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.13"
}
